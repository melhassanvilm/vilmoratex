{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vilmoratex",
  "main": ".open-next/worker.js",
  // Keep this at 2024-09-23 or later — required by @opennextjs/cloudflare.
  // Bump it forward periodically; see https://developers.cloudflare.com/workers/configuration/compatibility-dates/
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
